# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ⚠️ গোপন কী (service_role) — স্টাফ অ্যাকাউন্ট তৈরির জন্য, শুধু সার্ভারে ব্যবহার হয়।
# কখনো NEXT_PUBLIC_ দিয়ে শুরু করবেন না, কাউকে দেবেন না, GitHub-এ তুলবেন না।
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# (ঐচ্ছিক) ট্রায়াল শেষ বা দোকান স্থগিত হলে ব্যবহারকারীকে যে নম্বরে যোগাযোগ করতে বলা হবে
NEXT_PUBLIC_SUPPORT_PHONE=
